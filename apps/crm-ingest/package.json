{
  "name": "@novu/crm-ingest",
  "version": "3.18.1",
  "description": "izipush CRM — reçoit les événements d'Izichange et tient à jour profils et activité",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "docker:build": "pnpm --silent --workspace-root pnpm-context -- apps/crm-ingest/Dockerfile | docker buildx build --load --build-arg PACKAGE_PATH=apps/crm-ingest - -t novu-crm-ingest $DOCKER_BUILD_ARGUMENTS",
    "start": "pnpm start:dev",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "cross-env TS_NODE_TRANSPILE_ONLY=true NODE_ENV=test NODE_OPTIONS=--no-experimental-strip-types mocha --timeout 10000 --require ts-node/register --exit 'src/**/*.spec.ts'",
    "demo:lot1": "node scripts/demo-lot1.mjs",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/terminus": "11.1.1",
    "@novu/application-generic": "workspace:*",
    "@novu/dal": "workspace:*",
    "@novu/shared": "workspace:*",
    "@sentry/nestjs": "^10.63.0",
    "@sentry/node": "^10.63.0",
    "amqplib": "^2.0.1",
    "bullmq": "^3.10.2",
    "cron-parser": "^4.9.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^16.4.5",
    "envalid": "^8.2.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "^3.0.2",
    "rxjs": "7.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/chai": "^4.3.4",
    "@types/express": "^4.17.8",
    "@types/mocha": "^10.0.2",
    "@types/node": "^22.0.0",
    "chai": "^4.2.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.2.0",
    "ts-node": "~10.9.1",
    "typescript": "5.6.2"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx biome lint apps/crm-ingest"
        }
      }
    }
  }
}
