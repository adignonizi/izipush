# izipush — variables de déploiement. Copier en .env, puis : chmod 600 .env
#

# ── Adresses publiques ───────────────────────────────────────────────────────
# Servent à construire les liens absolus des emails — désinscription, pixel
# d'ouverture, liens suivis. Doivent être les URL vues depuis l'extérieur.
API_ROOT_URL=https://izipush.exemple.com/api
FRONT_BASE_URL=https://izipush.exemple.com
CRM_PUBLIC_API_URL=https://izipush.exemple.com/api


# ── Ports internes ───────────────────────────────────────────────────────────
API_PORT=3000
WS_PORT=3002
WORKER_PORT=3004

# ── Redis ────────────────────────────────────────────────────────────────────
# Mot de passe inutile tant que Redis reste sur le réseau interne du compose.
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# ── Secrets ──────────────────────────────────────────────────────────────────
JWT_SECRET=                      # À GÉNÉRER
STORE_ENCRYPTION_KEY=            # À GÉNÉRER — chiffre les identifiants des fournisseurs
# NOVU_SECRET_KEY — ni à générer, ni lu par les services déployés. C'est le nom
# sous lequel une application CLIENTE (Bridge, SDK serveur) range la clé API d'un
# environnement, celle de Settings > API Keys. izipush, lui, valide cette clé
# contre `environments.apiKeys.hash`, et crm-ingest la lit dans la base par
# environnement — jamais dans ce fichier. Une valeur tirée au hasard n'y sert donc
# à rien : la clé n'existe qu'une fois l'environnement créé.
#NOVU_SECRET_KEY=
CRM_UNSUBSCRIBE_SECRET=          # À GÉNÉRER — signe les liens de désinscription et de suivi
CRM_ADMIN_TOKEN=                 # À GÉNÉRER — commandes d'administration du CRM
KEYCLOAK_WEBHOOK_SECRET=         # fourni par Izichange

# Changer STORE_ENCRYPTION_KEY rend ILLISIBLES les identifiants de fournisseurs
# déjà enregistrés. Ils devront être ressaisis dans l'interface.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=izipush
MONGO_INITDB_ROOT_PASSWORD=      # À GÉNÉRER
MONGO_URL=mongodb://izipush:MOT_DE_PASSE@mongodb:27017/novu-db?authSource=admin
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=100
MONGO_AUTO_CREATE_INDEXES=true

# Vers DocumentDB, la chaîne DOIT porter retryWrites=false — le pilote l'active
# par défaut et DocumentDB le refuse, chaque écriture échouerait :
#   mongodb://user:pass@cluster.docdb.amazonaws.com:27017/novu-db?tls=true&retryWrites=false&replicaSet=rs0

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# Courtier d'Izichange ou Amazon MQ.
AMQP_URL=
AMQP_EXCHANGE=mailwizz-topic
# product.* doit rester présent, sinon les activations de produit ne sont
# jamais reçues : la file n'y est tout simplement pas liée.
AMQP_BINDINGS=account.*,kyc.*,transaction.*,product.*
# Seulement avec --profile broker-local, à faire correspondre à AMQP_URL :
RABBITMQ_USER=izipush
RABBITMQ_PASSWORD=

# ── CRM ──────────────────────────────────────────────────────────────────────
# FACULTATIVES. Elles ne servent plus que de repli, pour les enveloppes sans
# `application_id`. Tout le reste du pipeline lit le locataire porté par la
# tâche, et l'ordonnanceur de campagnes l'a toujours lu sur le document.
#
# Ne les laisser vides QUE si Izichange émet `application_id` : sinon chaque
# événement est rejeté faute de destination — franchement, jamais rangé au
# hasard.
#
# Relevées à la première connexion au tableau de bord : elles n'existent pas
# avant que l'organisation et l'environnement ne soient créés.
CRM_ENVIRONMENT_ID=
CRM_ORGANIZATION_ID=

# ── Reseau ───────────────────────────────────────────────────────────────────
# Nombre de proxys que NOUS controlons devant l'API. Express s'en sert pour remonter
# la chaine X-Forwarded-For et rendre l'adresse du client reel.
#
# Indispensable a la liste d'autorisation d'adresses des cles API : sans lui, derriere
# le nginx du compose, chaque requete semble venir du proxy et la liste refuse tout le
# monde.
#
# Le nombre doit etre EXACT, pas genereux. X-Forwarded-For est fourni par l'appelant :
# seules les entrees ajoutees par nos propres proxys sont dignes de foi, et elles sont
# les plus a droite. Trop grand, on remonte dans la partie fournie par le client, qui
# peut alors se declarer a l'adresse de son choix et contourner la liste. Trop petit,
# tout le monde est refuse — panne visible, donc preferable.
#
#   1  le compose tel quel (nginx seul)
#   2  derriere un ALB qui parle a ce nginx
#   0  API exposee en direct, sans aucun proxy
API_TRUSTED_PROXY_HOPS=1

# ── Drapeaux fonctionnels ────────────────────────────────────────────────────
#IS_V2_ENABLED=true
# Les deux suivantes valent DEJA true par defaut dans le compose : les commenter ne
# les desactive pas. Ne les ecrire que pour les mettre a false, ce qui n'est pas
# conseille.
#
# Idempotence : l'intercepteur met en cache 24 h la reponse des appels authentifies
# par cle API qui portent un en-tete `Idempotency-Key`, par organisation et
# environnement. C'est la SEULE protection contre le double envoi — le champ
# `transactionId` du corps ne deduplique rien dans ce depot, contrairement a ce que
# laisse croire la documentation de la route, qui decrit l'offre hebergee.
IS_API_IDEMPOTENCY_ENABLED=true
# Limitation de debit : borne un incident au lieu de le laisser total — une boucle
# dans l'appelant, un rejeu de file.
IS_API_RATE_LIMITING_ENABLED=true
IS_NEW_MESSAGES_API_RESPONSE_ENABLED=true
#IS_EMAIL_INLINE_CSS_DISABLED=false
#IS_USE_MERGED_DIGEST_ID_ENABLED=false
#BROADCAST_QUEUE_CHUNK_SIZE=100
#MULTICAST_QUEUE_CHUNK_SIZE=100
#SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME=15 days