# izipush — variables de déploiement. Copier en .env, puis : chmod 600 .env
#
# Les valeurs « À GÉNÉRER » se produisent avec :  openssl rand -hex 32

# ── Images ───────────────────────────────────────────────────────────────────
# Dépôt ECR, sans le nom d'image. Exemple :
#   123456789012.dkr.ecr.eu-west-3.amazonaws.com
IMAGE_REGISTRY=
IMAGE_TAG=latest

# Processus PM2 par service. Garder ÉGAL au nombre de vCPU de l'instance :
# chaque processus consomme sa propre mémoire (~370 Mio pour l'api).
PM2_INSTANCES=2

# ── Exposition ───────────────────────────────────────────────────────────────
# 127.0.0.1 si un proxy tourne sur l'hôte ; 0.0.0.0 derrière un ALB.
ROUTER_BIND=127.0.0.1
ROUTER_PORT=80

# URL PUBLIQUE de l'API, préfixe compris. Sert à construire les liens absolus
# des emails — désinscription, pixel d'ouverture, liens suivis.
API_ROOT_URL=https://izipush.exemple.com/api
FRONT_BASE_URL=https://izipush.exemple.com
CRM_PUBLIC_API_URL=https://izipush.exemple.com/api
API_CONTEXT_PATH=

API_PORT=3000
WS_PORT=3002
WORKER_PORT=3004

# ── Secrets ──────────────────────────────────────────────────────────────────
JWT_SECRET=                      # À GÉNÉRER
STORE_ENCRYPTION_KEY=            # À GÉNÉRER — chiffre les identifiants des fournisseurs
NOVU_SECRET_KEY=                 # À GÉNÉRER
CRM_UNSUBSCRIBE_SECRET=          # À GÉNÉRER — signe les liens de désinscription et de suivi
CRM_ADMIN_TOKEN=                 # À GÉNÉRER — commandes d'administration du CRM
KEYCLOAK_WEBHOOK_SECRET=         # fourni par Izichange

# Changer STORE_ENCRYPTION_KEY rend ILLISIBLES les identifiants de fournisseurs
# déjà enregistrés. Ils devront être ressaisis dans l'interface.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=izipush
MONGO_INITDB_ROOT_PASSWORD=      # À GÉNÉRER
MONGO_URL=mongodb://izipush:MOT_DE_PASSE@mongodb:27017/novu-db?authSource=admin
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=100
MONGO_AUTO_CREATE_INDEXES=true

# Vers DocumentDB, la chaîne DOIT porter retryWrites=false — le pilote l'active
# par défaut et DocumentDB le refuse, chaque écriture échouerait :
#   mongodb://user:pass@cluster.docdb.amazonaws.com:27017/novu-db?tls=true&retryWrites=false&replicaSet=rs0

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                  # À GÉNÉRER si Redis est joignable hors de l'hôte
REDIS_CACHE_SERVICE_HOST=redis
REDIS_CACHE_SERVICE_PORT=6379

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# Courtier d'Izichange ou Amazon MQ. Avec --profile broker-local :
#   AMQP_URL=amqp://izipush:MOT_DE_PASSE@rabbitmq:5672
AMQP_URL=
AMQP_EXCHANGE=mailwizz-topic
AMQP_BINDINGS=account.*,kyc.*,transaction.*,product.*
RABBITMQ_USER=izipush
RABBITMQ_PASSWORD=               # seulement avec le profil broker-local

# ── CRM ──────────────────────────────────────────────────────────────────────
# Relevés dans l'interface après création de l'organisation et de l'environnement.
CRM_ENVIRONMENT_ID=
CRM_ORGANIZATION_ID=

# ── Stockage objet ───────────────────────────────────────────────────────────
S3_BUCKET_NAME=
S3_REGION=eu-west-3
S3_LOCAL_STACK=
# Laisser VIDES sur EC2 ou ECS : le rôle d'instance suffit et évite des clés
# statiques dans un fichier.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── izinews (compagnon de test) ──────────────────────────────────────────────
IZINEWS_NOVU_API_KEY=            # Settings > API Keys > Secret Key
IZINEWS_WORKFLOW=izinews-alert
IZINEWS_VAPID_KEY=               # Firebase > Cloud Messaging > certificats Web Push
FB_API_KEY=
FB_AUTH_DOMAIN=
FB_PROJECT_ID=
FB_STORAGE_BUCKET=
FB_SENDER_ID=
FB_APP_ID=

# ── Drapeaux ─────────────────────────────────────────────────────────────────
IS_V2_ENABLED=true
IS_API_IDEMPOTENCY_ENABLED=true
IS_API_RATE_LIMITING_ENABLED=true
IS_NEW_MESSAGES_API_RESPONSE_ENABLED=true
IS_EMAIL_INLINE_CSS_DISABLED=false
IS_USE_MERGED_DIGEST_ID_ENABLED=false
BROADCAST_QUEUE_CHUNK_SIZE=100
MULTICAST_QUEUE_CHUNK_SIZE=100
SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME=15 days

# ── Observabilité ────────────────────────────────────────────────────────────
SENTRY_DSN=
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=
NEW_RELIC_LICENSE_KEY=
