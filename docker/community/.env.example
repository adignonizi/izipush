# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
# used as a secret to verify the JWT token signature
# REQUIRED: Generate a cryptographically random value before starting.
# Example: openssl rand -hex 32
JWT_SECRET=
# expressed in seconds or a string describing a time span [zeit/ms](https://github.com/zeit/ms.js).  Eg: 60, "2 days", "10h", "7d"
SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME=15d
# used to encrypt/decrypt the provider credentials
# REQUIRED: Must be exactly 32 characters. Generate with: openssl rand -hex 16
STORE_ENCRYPTION_KEY=

# Random generated secret key.
# REQUIRED: Generate a cryptographically random value before starting.
# Example: openssl rand -hex 32
NOVU_SECRET_KEY=

# Host
HOST_NAME=http://localhost

# General
# available values 'dev', 'test', 'production', 'ci', 'local'
NODE_ENV=local
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=5

# MONGO USER
MONGO_INITDB_ROOT_USERNAME=root
# MONGO PASSWORD
MONGO_INITDB_ROOT_PASSWORD=secret
MONGO_URL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/novu-db?authSource=admin
MONGO_AUTO_CREATE_INDEXES=true

REDIS_HOST=redis

REDIS_PASSWORD=
REDIS_CACHE_SERVICE_HOST=
# Set to true when connecting through a proxy that does not support the Redis INFO command
REDIS_SKIP_VERSION_CHECK=false

# AWS
S3_LOCAL_STACK=${HOST_NAME}:4566
S3_BUCKET_NAME=novu-local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Ports
API_PORT=3000
REDIS_PORT=6379
REDIS_CACHE_SERVICE_PORT=6379
WS_PORT=3002
WORKER_PORT=3004

# Root URL
VITE_API_HOSTNAME=${HOST_NAME}:3000
VITE_WEBSOCKET_HOSTNAME=${HOST_NAME}:3002
API_ROOT_URL=${HOST_NAME}:3000
FRONT_BASE_URL=${HOST_NAME}:(4000|4200)
IS_API_IDEMPOTENCY_ENABLED=false
IS_API_RATE_LIMITING_ENABLED=false
IS_NEW_MESSAGES_API_RESPONSE_ENABLED=true
IS_V2_ENABLED=true
IS_SELF_HOSTED=true
IS_EMAIL_INLINE_CSS_DISABLED=false
IS_USE_MERGED_DIGEST_ID_ENABLED=false


# Analytics
SENTRY_DSN=

# update these values in case you are using New Relic, by default New Relic is disabled
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME="NEW_RELIC_APP_NAME"
NEW_RELIC_LICENSE_KEY="NEW_RELIC_LICENSE_KEY"

BROADCAST_QUEUE_CHUNK_SIZE=100
MULTICAST_QUEUE_CHUNK_SIZE=100

# ─── izipush-crm ────────────────────────────────────────────────────────────────
# Image de crm-ingest. Elle n'existe pas en amont chez Novu : construire depuis ce dépôt avec
#   pnpm --filter @novu/crm-ingest docker:build
CRM_INGEST_IMAGE=novu-crm-ingest
CRM_INGEST_PORT=3010

# Environnement Novu dans lequel le CRM tient les profils à jour, et sa clé secrète (Settings > API Keys).
CRM_ENVIRONMENT_ID=
CRM_ORGANIZATION_ID=
CRM_NOVU_SECRET_KEY=

# RabbitMQ d'Izichange. Notre file est liée à leur exchange existant : les autres consommateurs
# (MailWizz) continuent de recevoir. Pour une pile autonome de recette, lancer le broker fourni avec
#   docker compose --profile local-broker up -d
# et pointer AMQP_URL sur amqp://izipush:izipush@rabbitmq:5672
AMQP_URL=
AMQP_EXCHANGE=mailwizz-topic
AMQP_QUEUE=izipush.crm-ingest
AMQP_BINDINGS=account.*,kyc.*,transaction.*
RABBITMQ_DEFAULT_USER=izipush
RABBITMQ_DEFAULT_PASS=izipush

# URL publique de l'API, telle qu'elle apparaît dans les emails (désinscription, pixel, liens suivis).
CRM_PUBLIC_API_URL=
# Secret partagé par l'API, le worker et crm-ingest : signe et vérifie les jetons de ces liens.
# Au moins 32 caractères aléatoires. Le changer invalide les liens des emails déjà partis.
CRM_UNSUBSCRIBE_SECRET=

# Signature du webhook Keycloak (HMAC-SHA256 du corps). Vide = aucune vérification.
KEYCLOAK_WEBHOOK_SECRET=
# Jeton des routes d'administration de crm-ingest (relecture de la file d'erreurs). Vide = désactivées.
CRM_ADMIN_TOKEN=

